/*
 * Device Tree overlay for nice!nano — WS2812 driven over I2S.
 *
 * WHY I2S AND NOT SPI:
 * Every SPI transfer on this board faults with K_ERR_ARM_MEM_DATA_ACCESS (an
 * MPU data-access violation), including a bare 1-byte spi_write_dt(), on both
 * SPIM1 and SPIM3, with the strip disconnected. That crash is unexplained.
 * I2S drives the same pin through a separate path and works.
 *
 * Data goes out on P0.29.
 *
 * I2S requires SCK and LRCK to be assigned even though WS2812 uses only the
 * data line, so they are parked on P0.22 and P0.24 — free on this board and
 * nothing is wired to them. They toggle harmlessly.
 */

#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/ {
    chosen {
        /* No console: the app runs headless (see prj.conf). USB CDC as the
         * console resets the board on flash writes when no host drains the
         * port, so USB is not brought up at all. */

        /* The SoC dtsi points entropy at the CryptoCell. That driver is
         * disabled (CONFIG_HW_CC3XX=n — it fails to link against picolibc
         * with this toolchain), so use the plain RNG peripheral instead. */
        zephyr,entropy = &rng;
    };

    aliases {
        led-strip = &led_strip;
    };

    led_strip: ws2812 {
        /*
         * In-tree fork of the WS2812 I2S driver (drivers/ws2812_i2s_runtime/)
         * with a RUNTIME-switchable colour order, so one firmware image drives
         * both a 3-channel GRB WS2812 strip and a 4-channel GRBW SK6812-RGBW
         * strip. The order is set over BLE ("O<order>") and persisted to NVS.
         */
        compatible = "blled,ws2812-i2s-runtime";

        i2s-dev = <&i2s0>;
        /*
         * MAXIMUM supported pixels, not the number connected. This sizes the
         * static I2S DMA buffer, so it is fixed at build time; the count
         * actually lit is set over BLE ("N<count>") and persisted to NVS.
         *
         * 72 = two 36-pixel rings wired in series, the largest product build.
         * Cost is ~24 bytes of RAM per pixel of headroom.
         */
        chain-length = <72>;

        /*
         * DEFAULT colour order: GRB (a stock WS2812), used until the app sets
         * one from NVS at boot. The runtime may switch to RGB/GRBW/RGBW over
         * BLE; `max-colors` sizes the I2S DMA buffer for the widest of those (4,
         * for the RGBW variants) so widening the order at run time still fits.
         */
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
        max-colors = <4>;

        reset-delay = <120>;

        /*
         * Default 300 us is not enough — the peripheral is still draining
         * when the next write arrives and it gets rejected with -EIO
         * ("Cannot write in state: 3" = I2S_STATE_STOPPING).
         *
         * 10 ms is the value that produced the best result so far: the strip
         * showed red, then a single green pixel, i.e. more than one frame got
         * through. Not yet reliable for every frame.
         */
        extra-wait-time = <10000>;
    };
};

/*
 * Battery sense — INTERNAL VDDHDIV5, no external parts.
 *
 * The SAADC has a special input, VDDHDIV5, that samples the chip's VDDH pin
 * divided by 5 inside the die — no divider resistors, no GPIO consumed. On the
 * nice!nano the cell (B+) feeds VDDH, so this reads the battery directly; it is
 * how a genuine nice!nano v2 measures its own battery. The x5 is undone by the
 * vbatt full/output ratio below, so battery.c needs no change.
 *
 * A cell tops out at 4.2 V, over the SAADC's 3.6 V ceiling at the best gain, so
 * it must be scaled: 4.2 V / 5 = 0.84 V max at the input, comfortably inside the
 * 3.6 V full-scale window.
 *
 * CAVEATS:
 *   - This measures VDDH, not the cell as such. On USB power the rail is the
 *     ~5 V input, not the battery, so a reading of ~5 V means "on charger", not
 *     "overcharged cell". Trust the number only on battery.
 *   - Requires that B+ actually reaches VDDH — true on genuine nice!nano and
 *     most clones. VERIFY once against a multimeter on the cell before trusting
 *     it, the same way the resistor version below was validated.
 *
 * PREVIOUS external-divider version (P0.02/AIN0), kept for reference if the two
 * resistors are ever fitted:
 *
 *   BAT+ ──[ 100k ]──┬──[ 100k ]── GND
 *                    │
 *                  P0.02 (AIN0)
 *
 *   channel@0: zephyr,input-positive = <NRF_SAADC_AIN0>;
 *              acquisition-time = 40 us (50k source impedance needs a long
 *              window to charge the sampling cap);
 *   vbatt:     output-ohms = <100000>; full-ohms = <200000>;
 *
 * Some clones instead ship a divider on P0.31/AIN7 — if yours does, use AIN7
 * and MEASURE the ratio, it varies.
 */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";              /* 0.6 V ref x 6 = 3.6 V FS */
        zephyr,reference = "ADC_REF_INTERNAL";
        /* VDDHDIV5 is a low-impedance internal source, but a generous window
         * costs nothing here and keeps the reading quiet. */
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_VDDHDIV5>;
        zephyr,resolution = <12>;
    };
};

/ {
    /*
     * Battery sense scaling. The "voltage-divider" binding is reused purely for
     * its full/output ratio: battery.c multiplies the ADC reading by
     * full-ohms/output-ohms, so 5/1 undoes the VDDHDIV5 divide-by-five and
     * recovers the cell voltage. There are no physical resistors now.
     *
     * Kept enabled (status = "okay") because the sense path is always present:
     * VDDHDIV5 is internal and cannot be "unfitted" like the old resistors. The
     * plausibility window in battery.c still guards against a board where B+
     * does not reach VDDH — an implausible reading disables monitoring rather
     * than blanking the strip. VERIFY once against a multimeter on the cell.
     */
    vbatt: vbatt {
        compatible = "voltage-divider";
        status = "okay";
        io-channels = <&adc 0>;
        output-ohms = <1>;      /* VDDHDIV5 → cell = reading x 5 */
        full-ohms   = <5>;
    };
};

&pinctrl {
    i2s0_default_alt: i2s0_default_alt {
        group1 {
            psels = <NRF_PSEL(I2S_SCK_M, 0, 22)>,
                    <NRF_PSEL(I2S_LRCK_M, 0, 24)>,
                    <NRF_PSEL(I2S_SDOUT, 0, 29)>;
        };
    };
};

&i2s0 {
    status = "okay";
    pinctrl-0 = <&i2s0_default_alt>;
    pinctrl-names = "default";
};

/* SPI is not used for the strip — it crashes the CPU on this board. */
&spi1 {
    status = "disabled";
};

&spi3 {
    status = "disabled";
};
